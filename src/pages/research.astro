---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import PaperCard from "@/components/PaperCard.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const papers = await getCollection("research", ({ data }) => !data.draft);
const sortedPapers = papers.sort(
  (a, b) =>
    b.data.year - a.data.year || a.data.title.localeCompare(b.data.title)
);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout
  title={`${t.pages.researchTitle} | ${config.site.title}`}
  description={t.pages.researchDesc}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.researchTitle} pageDesc={t.pages.researchDesc}>
    <ul class="flex flex-col gap-6">
      {sortedPapers.map(({ data }) => <PaperCard {...data} />)}
    </ul>
  </Main>

  <Footer />
</Layout>
