---
import { getCollection, getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

const about = await getEntry("pages", "about");
const AboutContent = about ? (await render(about)).Content : null;

// Drop a photo at src/assets/images/avatar.{jpg,jpeg,png,webp} to show it in the hero.
const avatarImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/avatar.{jpg,jpeg,png,webp}",
  { eager: true }
);
const avatar = Object.values(avatarImages)[0]?.default;
const initials = config.site.author
  .split(" ")
  .map(word => word[0])
  .slice(0, 2)
  .join("");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section
      id="hero"
      class="border-border flex flex-col gap-6 border-b pt-8 pb-8 sm:flex-row sm:items-center sm:gap-8"
    >
      {
        avatar ? (
          <Image
            src={avatar}
            alt={config.site.author}
            width={320}
            height={320}
            loading="eager"
            class="size-32 shrink-0 rounded-full object-cover sm:size-40"
          />
        ) : (
          <div
            aria-hidden="true"
            class="bg-muted text-accent flex size-32 shrink-0 items-center justify-center rounded-full text-4xl font-bold sm:size-40 sm:text-5xl"
          >
            {initials}
          </div>
        )
      }

      <div>
        <h1 class="inline-block text-3xl font-bold sm:text-4xl">
          Hi, I'm @alenunezarroyo.
        </h1>
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="inline-block"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss
            width={20}
            height={20}
            class="stroke-accent ms-2 scale-125 stroke-3 rtl:-rotate-90"
          />
          <span class="sr-only">RSS Feed</span>
        </a>

        <p class="mt-3">
          Researching LLM-based agents and multi-agent systems. Papers, notes
          and experiments along the way.
        </p>
        {socials.length > 0 && (
          <div class="mt-3 -ms-2 sm:-ms-1">
            <Socials />
          </div>
        )}
      </div>
    </section>

    {
      AboutContent && (
        <section id="about" class="border-border border-b pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">{t.nav.about}</h2>
          <div class="app-prose mt-4 max-w-none">
            <AboutContent />
          </div>
        </section>
      )
    }

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
