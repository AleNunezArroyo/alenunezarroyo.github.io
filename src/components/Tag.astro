---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  /** Overrides the default `/posts/tag/{tag}/` link. */
  href?: string;
  /** Number of posts with this tag, shown next to its name. */
  count?: number;
  /** Highlights the tag as the currently selected filter. */
  active?: boolean;
};

const { tag, tagName, size = "lg", href, count, active = false } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={href ?? getRelativeLocaleUrl(locale, `posts/tag/${tag}/`)}
    transition:name={tag}
    aria-current={active ? "page" : undefined}
    class:list={[
      "flex items-center gap-0.5",
      "border-foreground border-b-2 border-dashed",
      "hover:border-accent hover:text-accent hover:-mt-0.5",
      "focus-visible:text-accent focus-visible:border-none",
      { "text-accent border-accent border-solid": active },
      { "text-sm": size === "sm" },
      { "text-lg": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-80",
        { "size-5": size === "lg" },
        { "size-4": size === "sm" },
      ]}
    />
    {tagName}
    {
      count !== undefined && (
        <span class="ms-1 text-sm opacity-60">({count})</span>
      )
    }
  </a>
</li>
