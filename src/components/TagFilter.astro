---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Tag from "./Tag.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { postFilter } from "@/utils/postFilter";
import { slugifyAll } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  /** Slug of the selected tag; omit when showing all posts. */
  activeTag?: string;
};

const { activeTag } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = (await getCollection("posts")).filter(postFilter);
// Most-used tags first; ties keep the alphabetical order from getUniqueTags.
const tags = getUniqueTags(posts)
  .map(({ tag, tagName }) => ({
    tag,
    tagName,
    count: posts.filter(({ data }) => slugifyAll(data.tags).includes(tag))
      .length,
  }))
  .sort((a, b) => b.count - a.count);
---

<ul class="border-border mb-6 flex flex-wrap gap-x-6 gap-y-3 border-b pb-6">
  <Tag
    tag="all-posts"
    tagName={t.pages.allTags}
    href={getRelativeLocaleUrl(locale, "posts/")}
    count={posts.length}
    active={!activeTag}
  />
  {
    tags.map(({ tag, tagName, count }) => (
      <Tag
        {tag}
        {tagName}
        {count}
        href={getRelativeLocaleUrl(locale, `posts/tag/${tag}/`)}
        active={tag === activeTag}
      />
    ))
  }
</ul>
